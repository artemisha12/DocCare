@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null; // Layout riêng cho trang auth (full-page split-screen)
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập — Hello Bác Sĩ</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
</head>
<body class="font-sans antialiased bg-gray-50">

<div class="min-h-screen flex">

    <!-- ════════════════════════════════════════════════
         LEFT PANEL — Brand / Banner
         ════════════════════════════════════════════════ -->
    <div class="hidden lg:flex lg:w-1/2 relative bg-gradient-to-br from-sky-600 via-blue-600 to-indigo-700 overflow-hidden">

        <!-- Decorative blobs -->
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-white opacity-5 rounded-full"></div>
        <div class="absolute bottom-0 right-0 w-80 h-80 bg-sky-300 opacity-10 rounded-full translate-x-1/3 translate-y-1/3"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] border border-white opacity-5 rounded-full"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] border border-white opacity-5 rounded-full"></div>

        <!-- Content -->
        <div class="relative z-10 flex flex-col justify-between p-12 w-full">

            <!-- Logo -->
            <a href="/" class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-white bg-opacity-20 flex items-center justify-center">
                    <i class="fa-solid fa-stethoscope text-white"></i>
                </div>
                <span class="text-2xl font-bold text-white">Hello Bác Sĩ</span>
            </a>

            <!-- Hero text -->
            <div class="space-y-6">
                <div class="inline-flex items-center gap-2 bg-white bg-opacity-15 rounded-full px-4 py-2">
                    <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
                    <span class="text-white text-sm font-medium">Tư vấn trực tuyến 24/7</span>
                </div>
                <h1 class="text-4xl xl:text-5xl font-extrabold text-white leading-tight">
                    Chào mừng<br />trở lại!
                </h1>
                <p class="text-sky-100 text-lg leading-relaxed max-w-sm">
                    Đăng nhập để tiếp tục chăm sóc sức khỏe cùng hơn <strong class="text-white">500+ bác sĩ chuyên khoa</strong> uy tín trên toàn quốc.
                </p>

                <!-- Feature pills -->
                <div class="flex flex-wrap gap-2 pt-2">
                    @foreach (var feat in new[] {
                        ("fa-calendar-check", "Đặt lịch nhanh"),
                        ("fa-video",          "Tư vấn trực tuyến"),
                        ("fa-heart-pulse",    "Theo dõi sức khỏe"),
                    })
                    {
                        <span class="flex items-center gap-1.5 bg-white bg-opacity-15 text-white text-xs font-medium px-3 py-1.5 rounded-full">
                            <i class="fa-solid @feat.Item1 text-sky-200 text-xs"></i> @feat.Item2
                        </span>
                    }
                </div>
            </div>

            <!-- Testimonial card -->
            <div class="bg-white bg-opacity-10 backdrop-blur rounded-2xl p-5 border border-white border-opacity-20">
                <div class="flex items-start gap-3">
                    <img src="https://randomuser.me/api/portraits/women/44.jpg"
                         alt="Avatar" class="w-10 h-10 rounded-full ring-2 ring-white ring-opacity-50 shrink-0" />
                    <div>
                        <p class="text-white text-sm leading-relaxed italic">
                            "Tôi đặt lịch khám online chỉ mất 2 phút, bác sĩ tư vấn rất tận tâm. Dịch vụ xuất sắc!"
                        </p>
                        <p class="text-sky-200 text-xs mt-1.5 font-medium">Trần Thị Lan · TP. Hồ Chí Minh</p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ════════════════════════════════════════════════
         RIGHT PANEL — Login Form
         ════════════════════════════════════════════════ -->
    <div class="w-full lg:w-1/2 flex flex-col justify-center px-6 sm:px-12 lg:px-16 xl:px-24 py-12 bg-white">

        <!-- Mobile logo (visible only on small screens) -->
        <a href="/" class="flex items-center gap-2 mb-8 lg:hidden">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-sky-500 to-blue-600 flex items-center justify-center">
                <i class="fa-solid fa-stethoscope text-white text-sm"></i>
            </div>
            <span class="text-xl font-bold"><span class="text-sky-500">Hello</span><span class="text-gray-800"> Bác Sĩ</span></span>
        </a>

        <div class="max-w-md w-full mx-auto">

            <!-- Header -->
            <div class="mb-8">
                <h2 class="text-3xl font-extrabold text-gray-900">Đăng nhập</h2>
                <p class="mt-2 text-gray-500 text-sm">Chưa có tài khoản?
                    <a href="/Account/Register" class="text-sky-500 font-semibold hover:text-sky-600">Đăng ký ngay</a>
                </p>
            </div>

            <!-- Success message từ Register redirect -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-6 flex items-start gap-3 bg-green-50 border border-green-200 rounded-xl px-4 py-3">
                    <i class="fa-solid fa-circle-check text-green-500 mt-0.5 shrink-0"></i>
                    <p class="text-sm text-green-700">@TempData["SuccessMessage"]</p>
                </div>
            }

            <!-- Global error -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
            {
                <div class="mb-6 flex items-start gap-3 bg-red-50 border border-red-200 rounded-xl px-4 py-3">
                    <i class="fa-solid fa-circle-exclamation text-red-500 mt-0.5 shrink-0"></i>
                    <div asp-validation-summary="ModelOnly" class="text-sm text-red-700"></div>
                </div>
            }

            <!-- Mock hint -->
            <div class="mb-6 bg-sky-50 border border-sky-200 rounded-xl px-4 py-3 flex items-start gap-2">
                <i class="fa-solid fa-flask text-sky-500 text-sm mt-0.5 shrink-0"></i>
                <p class="text-xs text-sky-700">
                    <strong>Test account:</strong> <code class="bg-sky-100 px-1 rounded">demo@hellobacsi.vn</code> /
                    <code class="bg-sky-100 px-1 rounded">Demo@1234</code>
                </p>
            </div>

            <!-- Form -->
            <form asp-action="Login" asp-controller="Account" method="post" class="space-y-5">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <!-- Email / SĐT -->
                <div>
                    <label asp-for="EmailOrPhone" class="block text-sm font-semibold text-gray-700 mb-1.5"></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                            <i class="fa-regular fa-envelope text-gray-400 text-sm"></i>
                        </span>
                        <input asp-for="EmailOrPhone"
                               type="text"
                               placeholder="email@example.com hoặc 09xxxxxxxx"
                               autocomplete="username"
                               class="w-full pl-10 pr-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-800 placeholder-gray-400
                                      focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent transition-shadow
                                      @(ViewData.ModelState["EmailOrPhone"]?.Errors.Count > 0 ? "border-red-400 bg-red-50" : "")" />
                    </div>
                    <span asp-validation-for="EmailOrPhone" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <!-- Password -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label asp-for="Password" class="text-sm font-semibold text-gray-700"></label>
                        <a href="/Account/ForgotPassword" class="text-xs text-sky-500 hover:text-sky-600 font-medium">Quên mật khẩu?</a>
                    </div>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                            <i class="fa-solid fa-lock text-gray-400 text-sm"></i>
                        </span>
                        <input asp-for="Password"
                               type="password"
                               id="passwordInput"
                               placeholder="Nhập mật khẩu của bạn"
                               autocomplete="current-password"
                               class="w-full pl-10 pr-11 py-3 border border-gray-200 rounded-xl text-sm text-gray-800 placeholder-gray-400
                                      focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent transition-shadow
                                      @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "border-red-400 bg-red-50" : "")" />
                        <!-- Toggle show/hide password -->
                        <button type="button" id="togglePassword"
                                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-gray-400 hover:text-gray-600 transition-colors"
                                aria-label="Hiện/ẩn mật khẩu">
                            <i class="fa-regular fa-eye text-sm" id="toggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <!-- Remember me -->
                <div class="flex items-center gap-2">
                    <input asp-for="RememberMe" type="checkbox" id="rememberMe"
                           class="w-4 h-4 rounded border-gray-300 text-sky-500 focus:ring-sky-500 cursor-pointer" />
                    <label for="rememberMe" class="text-sm text-gray-600 cursor-pointer select-none">Ghi nhớ đăng nhập</label>
                </div>

                <!-- Submit -->
                <button type="submit"
                        class="w-full flex items-center justify-center gap-2 py-3.5 px-4 bg-sky-500 hover:bg-sky-600 active:bg-sky-700
                               text-white font-bold text-sm rounded-xl transition-colors shadow-md shadow-sky-100 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    Đăng nhập
                </button>

                <!-- Divider -->
                <div class="relative flex items-center gap-3 py-1">
                    <div class="flex-1 h-px bg-gray-200"></div>
                    <span class="text-xs text-gray-400 font-medium">HOẶC</span>
                    <div class="flex-1 h-px bg-gray-200"></div>
                </div>

                <!-- Social login (placeholder) -->
                <div class="grid grid-cols-2 gap-3">
                    <button type="button"
                            class="flex items-center justify-center gap-2 py-3 px-4 border border-gray-200 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                        <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-4 h-4" alt="Google" />
                        Google
                    </button>
                    <button type="button"
                            class="flex items-center justify-center gap-2 py-3 px-4 border border-gray-200 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                        <i class="fa-brands fa-facebook text-blue-600"></i>
                        Facebook
                    </button>
                </div>
            </form>

            <!-- Register link (bottom) -->
            <p class="mt-8 text-center text-sm text-gray-500">
                Chưa có tài khoản?
                <a href="/Account/Register" class="text-sky-500 font-semibold hover:text-sky-600">Đăng ký miễn phí</a>
            </p>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    // Toggle show/hide password
    const toggle   = document.getElementById('togglePassword');
    const input    = document.getElementById('passwordInput');
    const icon     = document.getElementById('toggleIcon');

    toggle?.addEventListener('click', () => {
        const isHidden = input.type === 'password';
        input.type     = isHidden ? 'text' : 'password';
        icon.classList.toggle('fa-eye',        !isHidden);
        icon.classList.toggle('fa-eye-slash',   isHidden);
    });
</script>

</body>
</html>
